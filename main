<body>
  <h1>YouTube Dashboard</h1>
  <p class="muted">Video testing aur multi-screen preview</p>

  <div class="stats">
    <div class="stat">
      <div class="muted">Account status</div>
      <div class="number">Not connected</div>
      <p class="muted">Google OAuth setup required</p>
    </div>
    <div class="stat">
      <div class="muted">Video screens</div>
      <div class="number" id="screenTotal">0</div>
    </div>
  </div>

  <div class="panel">
    <h2>YouTube Video Player</h2>
    <label for="videoUrl">YouTube video link</label>
    <input id="videoUrl"
      placeholder="https://www.youtube.com/watch?v=...">

    <label for="screenCount">Screens (1–20)</label>
    <input id="screenCount" type="number"
      min="1" max="20" value="1">

    <button onclick="createPlayers()">Create Screens</button>
    <button onclick="stopPlayers()">Stop All</button>
    <div id="message" class="muted"></div>
  </div>

  <div id="screens"></div>

  <script>
    function extractVideoId(value) {
      try {
        const url = new URL(value);
        let id = null;

        if (url.hostname === "youtu.be") {
          id = url.pathname.slice(1);
        } else if (
          ["youtube.com", "www.youtube.com",
           "m.youtube.com", "youtube-nocookie.com",
           "www.youtube-nocookie.com"].includes(url.hostname)
        ) {
          if (url.pathname === "/watch") {
            id = url.searchParams.get("v");
          } else {
            const match = url.pathname.match(
              /^\/(?:embed|shorts)\/([^/]+)/
            );
            id = match ? match[1] : null;
          }
        }

        return id && /^[\w-]{11}$/.test(id) ? id : null;
      } catch {
        return null;
      }
    }

    function createPlayers() {
      const id = extractVideoId(
        document.getElementById("videoUrl").value.trim()
      );
      const count = Number(
        document.getElementById("screenCount").value
      );
      const screens = document.getElementById("screens");
      const message = document.getElementById("message");

      if (!id) {
        message.textContent = "Valid YouTube link paste karo.";
        return;
      }

      if (!Number.isInteger(count) || count < 1 || count > 20) {
        message.textContent = "Screen count 1 se 20 ke beech rakho.";
        return;
      }

      screens.replaceChildren();

      for (let i = 0; i < count; i++) {
        const frame = document.createElement("iframe");
        frame.title = "Preview screen " + (i + 1);
        frame.src =
          "https://www.youtube-nocookie.com/embed/" +
          id + "?playsinline=1";
        frame.allow =
          "encrypted-media; picture-in-picture";
        frame.allowFullscreen = true;
        screens.appendChild(frame);
      }

      document.getElementById("screenTotal").textContent = count;
      message.textContent =
        count + " video player(s) created successfully.";
    }

    function stopPlayers() {
      document.getElementById("screens").replaceChildren();
      document.getElementById("screenTotal").textContent = "0";
      document.getElementById("message").textContent =
        "All players stopped.";
    }
  </script>
